# Application Settings
APP_NAME=ATTREQ
APP_ENV=development
APP_DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://attreq_user:attreq_password@localhost:5432/attreq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attreq_db
POSTGRES_USER=attreq_user
POSTGRES_PASSWORD=attreq_password

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","http://127.0.0.1:8081","https://attreq.vercel.app"]
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$
TRUSTED_HOSTS=["attreq.com","*.attreq.com","localhost","127.0.0.1"]

# Redis-backed public/costly-endpoint rate limits. Redis failures deliberately
# fail open and are logged, keeping the API available during a cache outage.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WARDROBE_IMAGES=20
RATE_LIMIT_WARDROBE_WINDOW_SECONDS=3600
RATE_LIMIT_STYLE_DNA_BUILDS=5
RATE_LIMIT_STYLE_DNA_WINDOW_SECONDS=3600
RATE_LIMIT_RECOMMENDATION_REFRESHES=20
RATE_LIMIT_RECOMMENDATION_WINDOW_SECONDS=3600

# Never trust forwarded client-IP headers on a directly exposed API. For the
# Pi Cloudflare Tunnel deployment, enable this only when the API is reachable
# solely from cloudflared, then allowlist the exact cloudflared source IP or the
# narrowly scoped Docker network CIDR (example only; replace after deployment).
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_TRUSTED_PROXY_CIDRS=[]

# Google OAuth (Optional - Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# External APIs
# Classifier selection: groq | claude | openai | gemini (default: groq)
CLASSIFIER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENWEATHER_API_KEY=

# RI-3: opt-in personal-color selfie estimation. Off by default — the face
# photo is transmitted to the configured CLASSIFIER_PROVIDER vendor for a
# single analysis call and is never stored. Requires per-request consent even
# when enabled.
ENABLE_PERSONAL_COLOR_SELFIE=false

# Error tracking (get DSN from sentry.io after creating a project)
SENTRY_DSN=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Object Storage ("local" = disk under UPLOAD_DIR, "s3" = S3-compatible e.g. Cloudflare R2)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Wardrobe batch upload settings
WARDROBE_BATCH_UPLOAD_MAX_FILES=20
WARDROBE_BATCH_PROCESSING_CONCURRENCY=3

# RI-6: FashionCLIP embeddings + optional LLM re-ranker. Off by default —
# EMBEDDINGS_ENABLED=true pulls in torch/transformers and downloads the
# ~600MB patrickjohncyh/fashion-clip checkpoint on first use (see
# services/ai/fashion_embeddings.py, requirements.txt). RERANKER_ENABLED
# reuses CLASSIFIER_PROVIDER for one extra text-only LLM call per generation
# (two if RERANKER_BOTH_ORDER=true).
EMBEDDINGS_ENABLED=false
RERANKER_ENABLED=false
RERANKER_BOTH_ORDER=false
