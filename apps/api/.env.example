# Application Settings
APP_NAME=ATTREQ
APP_ENV=development
APP_DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://attreq_user:attreq_password@localhost:5432/attreq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=attreq_db
POSTGRES_USER=attreq_user
POSTGRES_PASSWORD=attreq_password

# JWT Configuration
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8081","http://127.0.0.1:8081","https://attreq.vercel.app"]
BACKEND_CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|0\.0\.0\.0|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[0-1])\.\d{1,3}\.\d{1,3})(:\d+)?$
TRUSTED_HOSTS=["attreq.com","*.attreq.com","localhost","127.0.0.1"]

# Google OAuth (Optional - Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# External APIs
# Classifier selection: groq | claude | openai | gemini (default: groq)
CLASSIFIER_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
CLAUDE_API_KEY=
CLAUDE_MODEL_NAME=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
OPENWEATHER_API_KEY=

# Error tracking (get DSN from sentry.io after creating a project)
SENTRY_DSN=

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Wardrobe batch upload settings
WARDROBE_BATCH_UPLOAD_MAX_FILES=20
WARDROBE_BATCH_PROCESSING_CONCURRENCY=3
