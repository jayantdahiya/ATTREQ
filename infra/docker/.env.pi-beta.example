# Copy outside the Git checkout (recommended path:
# /mnt/storage/attreq/secrets/pi-beta.env), populate there, then chmod 600.
# This example records variable names and intent only. Do not commit real values.

# Required database identity and password; use new, unique production values.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Required at least 32-character JWT signing secret; generate a new value.
SECRET_KEY=

# Required named Cloudflare Tunnel token. Keep this hostname/tunnel credential
# distinct from the Mac development tunnel.
TUNNEL_TOKEN=

# Public beta hostname and allowed browser origins, expressed as JSON lists.
TRUSTED_HOSTS=
BACKEND_CORS_ORIGINS=
BACKEND_CORS_ORIGIN_REGEX=

# Active classifier and its matching provider credential. Groq is the current
# beta default; leave credentials for unused providers unset.
CLASSIFIER_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL_NAME=
GEMINI_API_KEY=
GEMINI_MODEL_NAME=
CLAUDE_API_KEY=
CLAUDE_MODEL_NAME=
OPENAI_API_KEY=
OPENAI_MODEL_NAME=
OPENWEATHER_API_KEY=

# Optional observability and private R2 S3-compatible object storage. BR-07
# decides these; use STORAGE_BACKEND=s3 only after R2 is verified.
SENTRY_DSN=
STORAGE_BACKEND=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Application rate limits. Enable Cloudflare forwarded client-IP headers only
# after inserting the exact Docker bridge CIDR discovered on the Pi.
RATE_LIMIT_ENABLED=
RATE_LIMIT_AUTH_ATTEMPTS=
RATE_LIMIT_AUTH_WINDOW_SECONDS=
RATE_LIMIT_WARDROBE_IMAGES=
RATE_LIMIT_WARDROBE_WINDOW_SECONDS=
RATE_LIMIT_STYLE_DNA_BUILDS=
RATE_LIMIT_STYLE_DNA_WINDOW_SECONDS=
RATE_LIMIT_RECOMMENDATION_REFRESHES=
RATE_LIMIT_RECOMMENDATION_WINDOW_SECONDS=
RATE_LIMIT_TRUST_PROXY_HEADERS=
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Keep false until BR-04 records measured approval for each component.
EMBEDDINGS_ENABLED=
RERANKER_ENABLED=
RERANKER_BOTH_ORDER=

# Compose-only Weaviate mode. Leave these unset for manual FashionCLIP
# vectors. Set to `text2vec-transformers` and
# `text2vec-transformers,backup-filesystem` only if BR-04 approves the
# transformer and both `weaviate` + `text2vec` profiles will be started.
WEAVIATE_DEFAULT_VECTORIZER_MODULE=
WEAVIATE_ENABLE_MODULES=

# ATTREQ_DATA_DIR and ATTREQ_API_IMAGE are non-secret operator shell variables,
# not entries in this file. Export them before invoking scripts/dev/pi-beta.sh.
