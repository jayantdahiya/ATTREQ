[Unit]
Description=ATTREQ PostgreSQL backup to private R2
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathIsDirectory=/opt/attreq
ConditionPathIsDirectory=/var/lib/attreq/backups
ConditionPathIsReadWrite=/var/lib/attreq/backups

[Service]
Type=oneshot
WorkingDirectory=/opt/attreq
Environment=ATTREQ_DATA_DIR=/var/lib/attreq
Environment=ATTREQ_ENV_FILE=/etc/attreq/pi-beta.env
ExecStart=/usr/bin/python3 /opt/attreq/scripts/dev/pi-microsd-backup.py backup
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/attreq/backups /run/docker.sock
