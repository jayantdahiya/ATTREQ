# Root .env — consumed by `make compose-up` (docker compose --env-file .env).
# Copy to `.env` and fill in. Only the variables below are interpolated into
# infra/docker/compose.api.yml; DB/Redis/Weaviate hosts, ports and credentials
# are hardcoded in that compose file, so they do NOT belong here.
#
# For running the API on your host instead (`make dev-api`), configure
# apps/api/.env from apps/api/.env.example — that file drives Pydantic settings.

# --- Required ---
# JWT signing key. Generate one with: openssl rand -hex 32
SECRET_KEY=

# --- AI classifier (optional; empty = classification runs in degraded/fallback mode) ---
# The live default provider is Groq. Get a key at https://console.groq.com
# qwen/qwen3.6-27b is Groq's current vision model (multimodal, 131K ctx, JSON mode
# + tool use, up to 5 images / 20MB) — the right fit for image→structured-tag
# classification and free on Groq's free tier (rate-limited, currently "preview").
# NOTE: the old meta-llama/llama-4-scout-* default has been retired from Groq.
GROQ_API_KEY=
GROQ_MODEL_NAME=qwen/qwen3.6-27b

# --- Weather (optional; empty = default-weather fallback) ---
# Get a key at https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Redis auth (optional; the dev compose Redis runs without a password) ---
REDIS_PASSWORD=

# --- Google OAuth (optional; Phase 2, unused in normal dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
